# Provenance — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# Every variable maps 1:1 to a field in provenance/config.py (Settings).

# --- LLM probing ---
# Anthropic is the only functional probe in v1; a run with no key still
# executes but every probe soft-fails and the run is marked "failed".
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-5
ANTHROPIC_DEFAULT_TEMPERATURE=0.2

# OpenAI + Gemini are stubbed drop-ins in v1 (registered but return a stub
# result). Fill these in when their probes are made functional.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# --- Database ---
# SQLite in v1; swap to a Postgres URL with zero schema change.
DATABASE_URL=sqlite:///./provenance.db

# --- Probe behavior (optional; sensible defaults shown) ---
DEFAULT_PROBE_MODE=isolation      # isolation | aggregate
PROBE_TIMEOUT_SECONDS=60
PROBE_MAX_RETRIES=3

# --- Signal collectors (optional; sensible defaults shown) ---
PYTRENDS_REQUEST_DELAY_SECONDS=1.0   # demand collector (Google Trends)
PYTRENDS_TIMEOUT=30
HN_TIMEOUT_SECONDS=15                 # social collector (Hacker News / Algolia)

# --- Logging (optional) ---
LOG_LEVEL=INFO
LOG_FORMAT=json
